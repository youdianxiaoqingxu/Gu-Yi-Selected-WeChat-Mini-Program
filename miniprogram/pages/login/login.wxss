.login {
  min-height: 100vh;
  padding: 0 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.logo {
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 34rpx;
}

.title {
  margin-bottom: 18rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #2B211B;
}

.subtitle {
  font-size: 26rpx;
  color: #917A62;
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.primary-btn {
  width: 100%;
  height: 100rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  background: #7D5233;
  color: #FFFDF7;
  box-shadow: 0 12rpx 28rpx rgba(125, 82, 51, 0.22);
}

.primary-btn-text {
  font-size: 32rpx;
  line-height: 1;
  color: #FFFDF7;
}

.primary-btn::after {
  border: none;
}

.tips {
  margin-top: 26rpx;
  font-size: 22rpx;
  color: #A99A88;
}
