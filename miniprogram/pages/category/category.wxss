.category {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.search-bar {
  margin: 16rpx 24rpx 4rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2EDE3;
  border-radius: 36rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #917A62;
}

.body {
  flex: 1;
  min-height: 0;
  display: flex;
}

.left {
  width: 180rpx;
  height: 100%;
  background: #F3E6D2;
}

.left-item {
  padding: 32rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #5A4330;
}

.left-item.active {
  background: #FFFDF7;
  color: #7D5233;
  font-weight: 600;
}

.right {
  flex: 1;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 20rpx;
}

.sort-item {
  font-size: 26rpx;
  color: #7C6854;
}

.sort-item.active {
  color: #7D5233;
  font-weight: 600;
}

.goods-list {
  padding-bottom: 24rpx;
}

.goods-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E8DCC8;
}

.goods-cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #F2E9DA;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  line-height: 38rpx;
  color: #2B211B;
}

.goods-subtitle {
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: #917A62;
}

.goods-foot {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-price-box {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 600;
  color: #7D5233;
}

.buy-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 26rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  background: #7D5233;
  color: #FFFDF7;
  font-size: 24rpx;
}
