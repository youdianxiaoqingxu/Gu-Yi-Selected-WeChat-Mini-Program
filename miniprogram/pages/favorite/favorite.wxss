.favorite {
  min-height: 100vh;
  padding: 24rpx;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48.5%;
  margin-bottom: 24rpx;
}

.unfav {
  display: block;
  margin-top: 12rpx;
  padding: 10rpx 0;
  text-align: center;
  border: 1rpx solid #DDC6A5;
  border-radius: 6px;
  font-size: 24rpx;
  color: #B04A3A;
}

