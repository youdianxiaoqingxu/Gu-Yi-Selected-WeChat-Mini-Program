<view class="profile">
  <image class="app-bg" src="/static/bg/app-bg.jpg" mode="aspectFill" />

  <view class="section-title">基本信息</view>
  <view class="group">
    <view class="row">
      <text class="label">头像</text>
      <view class="row-right">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{user.avatarDisplay}}" class="avatar" src="{{user.avatarDisplay}}" mode="aspectFill" />
          <view wx:else class="avatar avatar-fallback">{{user.nameFirst}}</view>
        </button>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="row">
      <text class="label">姓名</text>
      <view class="row-right">
        <input class="value input" value="{{user.realName}}" placeholder="请填写" bindblur="onRealNameBlur" />
      </view>
    </view>

    <view class="row">
      <text class="label">手机号</text>
      <view class="row-right">
        <input class="value input" type="number" maxlength="11" value="{{user.phone}}" placeholder="请填写手机号" bindblur="onPhoneBlur" />
      </view>
    </view>

    <view class="row">
      <text class="label">性别</text>
      <view class="row-right">
        <radio-group class="radio" bindchange="onGenderChange">
          <label class="radio-label"><radio value="1" checked="{{user.gender === 1}}" color="#7D5233" />男</label>
          <label class="radio-label"><radio value="2" checked="{{user.gender === 2}}" color="#7D5233" />女</label>
        </radio-group>
      </view>
    </view>

    <view class="row">
      <text class="label">生日</text>
      <view class="row-right">
        <picker mode="date" value="{{user.birthday}}" start="1900-01-01" end="2030-12-31" bindchange="onBirthdayChange">
          <text class="value {{user.birthday ? '' : 'placeholder'}}">{{user.birthday || '请选择'}}</text>
        </picker>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="row">
      <text class="label">地区</text>
      <view class="row-right">
        <picker mode="region" bindchange="onRegionChange">
          <text class="value {{user.region ? '' : 'placeholder'}}">{{user.region || '请选择'}}</text>
        </picker>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="row" bindtap="goAddress">
      <text class="label">收货地址</text>
      <view class="row-right">
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>
