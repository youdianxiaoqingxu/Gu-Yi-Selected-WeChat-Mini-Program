.detail {
  padding-bottom: 150rpx;
}

.gallery {
  width: 100%;
  height: 750rpx;
}

.gallery-img {
  width: 100%;
  height: 750rpx;
}

.info {
  padding: 28rpx 24rpx;
  background: #FFFDF7;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 44rpx;
  font-weight: 600;
  color: #7D5233;
}

.original {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #917A62;
  text-decoration: line-through;
}

.title {
  display: block;
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #2B211B;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #7C6854;
}

.tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  margin: 0 16rpx 16rpx 0;
  padding: 8rpx 18rpx;
  border-radius: 6px;
  background: #EDF1E8;
  color: #6D8065;
  font-size: 22rpx;
}

.block {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #FFFDF7;
  border-top: 1rpx solid #DDC6A5;
}

.block-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2B211B;
}

.spec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #DDC6A5;
  font-size: 26rpx;
}

.spec:last-child {
  border-bottom: none;
}

.spec-price {
  color: #7D5233;
}

.review {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #DDC6A5;
}

.review:last-child {
  border-bottom: none;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-nick {
  font-size: 26rpx;
  color: #2B211B;
}

.review-rating {
  font-size: 24rpx;
  color: #7D5233;
}

.review-content {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5A4330;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  background: #F5EAD8;
  border-top: 1rpx solid #E3D5BF;
}

.action-item {
  width: 104rpx;
  height: 116rpx;
  margin: 0;
  padding: 0;
  flex-grow: 0;
  flex-shrink: 0;
  flex-basis: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  line-height: 1;
}

.action-item::after {
  border: none;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}

.action-label {
  font-size: 22rpx;
  color: #5A4330;
  line-height: 1;
}

.action-label.active {
  color: #7D5233;
}

.buy-btn {
  flex-grow: 1;
  flex-shrink: 0;
  flex-basis: 0;
  min-width: 320rpx;
  margin-left: 16rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: #7D5233;
  color: #FFFDF7;
  font-size: 30rpx;
}
