.search {
  min-height: 100vh;
  padding: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx 0 28rpx;
  background: #FFFDF7;
  border: 1rpx solid #DDC6A5;
  border-radius: 36rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.search-btn {
  color: #7D5233;
  font-size: 26rpx;
}

.block-title {
  margin: 32rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2B211B;
}

.history {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.history-item {
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: #FFFDF7;
  border: 1rpx solid #DDC6A5;
  color: #5A4330;
  font-size: 24rpx;
}

.clear {
  margin-left: auto;
  color: #917A62;
  font-size: 24rpx;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48.5%;
  margin-bottom: 24rpx;
}

