<!-- 购物车：勾选 + 步进器 + 删除 + 底部合计结算 -->
<view class="cart">
  <image class="app-bg" src="/static/bg/app-bg.jpg" mode="aspectFill" />
  <block wx:if="{{items.length}}">
    <view class="cart-item" wx:for="{{items}}" wx:key="id">
      <checkbox class="check" checked="{{item.checked === 1}}" data-id="{{item.id}}" bindchange="onCheck" />
      <image class="cover" src="{{item.coverImg}}" mode="aspectFill" />
      <view class="info">
        <text class="title">{{item.goodsTitle}}</text>
        <text class="spec">{{item.specText || '标准款'}}</text>
        <view class="row">
          <text class="price">¥{{item.price}}</text>
          <view class="stepper">
            <text class="step" data-id="{{item.id}}" bindtap="onMinus">-</text>
            <text class="num">{{item.quantity}}</text>
            <text class="step" data-id="{{item.id}}" bindtap="onPlus">+</text>
          </view>
        </view>
      </view>
      <text class="del" data-id="{{item.id}}" bindtap="onDelete">删除</text>
    </view>

    <view class="bottom">
      <view class="all">
        <checkbox class="check" checked="{{allChecked}}" bindchange="onAllCheck" />
        <text>全选</text>
      </view>
      <view class="total">合计：¥{{total}}</view>
      <button class="checkout" bindtap="goCheckout">
        <image class="checkout-icon" src="/static/cart/consume-light.png" mode="aspectFit" />
        <text>结算({{selectedCount}})</text>
      </button>
    </view>
  </block>

  <view wx:elif="{{!loggedIn}}" class="cart-empty">
    <image class="empty-basket" src="/static/cart/empty-basket.png" mode="aspectFit" />
    <text class="empty-title">登录后可查看购物车商品</text>
    <view class="empty-btn" bindtap="goLogin">去登录</view>
  </view>
  <view wx:else class="cart-empty">
    <image class="empty-icon" src="/static/cart/empty-cart.svg" mode="aspectFit" />
    <text class="empty-title">暂无商品</text>
    <text class="empty-desc">选择喜欢的商品加入购物车</text>
    <view class="empty-btn" bindtap="goShopping">去逛逛</view>
  </view>
</view>
