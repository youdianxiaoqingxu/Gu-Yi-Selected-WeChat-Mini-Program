.order-detail {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
}

.status {
  padding: 32rpx 0;
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #7D5233;
}

.card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #FFFDF7;
  border: 1rpx solid #DDC6A5;
  border-radius: 8px;
}

.order-no {
  font-size: 24rpx;
  color: #7C6854;
}

.block-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2B211B;
}

.item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #DDC6A5;
}

.item:last-child {
  border-bottom: none;
}

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8px;
}

.info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.title {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  color: #2B211B;
}

.spec {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7C6854;
}

.right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 24rpx;
  color: #5A4330;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #5A4330;
}

.pay {
  color: #7D5233;
  font-weight: 600;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 24rpx;
  background: #FFFDF7;
  border-top: 1rpx solid #DDC6A5;
}

.btn {
  margin: 0 0 0 16rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 8px;
  font-size: 28rpx;
  color: #2B211B;
  background: #F3E6D2;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #7D5233;
  color: #FFFDF7;
}

