<!-- 订单详情：状态 + 商品 + 收货信息 + 金额 + 操作 -->
<view class="order-detail" wx:if="{{order}}">
  <image class="app-bg" src="/static/bg/app-bg.jpg" mode="aspectFill" />
  <view class="status">{{statusText}}</view>

  <view class="card">
    <view class="order-no" bindtap="copyOrderNo">订单号：{{order.orderNo}}（点击复制）</view>
  </view>

  <view class="card">
    <view class="block-title">商品</view>
    <view class="item" wx:for="{{order.items}}" wx:key="goodsId">
      <image class="cover" src="{{item.goodsImg}}" mode="aspectFill" />
      <view class="info">
        <text class="title">{{item.goodsTitle}}</text>
        <text class="spec">{{item.specText}}</text>
      </view>
      <view class="right">
        <text>¥{{item.price}}</text>
        <text>x{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="block-title">收货信息</view>
    <text class="line">{{order.receiverName}} {{order.receiverPhone}}</text>
    <text class="line">{{order.receiverAddr}}</text>
  </view>

  <view class="card">
    <view class="block-title">金额</view>
    <view class="line"><text>商品总额</text><text>¥{{order.totalAmount}}</text></view>
    <view class="line"><text>运费</text><text>¥{{order.freight}}</text></view>
    <view class="line"><text>实付金额</text><text class="pay">¥{{order.payAmount}}</text></view>
  </view>

  <view class="card" wx:if="{{order.remark}}">
    <view class="block-title">备注</view>
    <text class="line">{{order.remark}}</text>
  </view>

  <view class="bottom" wx:if="{{order.status === 0}}">
    <button class="btn" bindtap="onCancel">取消订单</button>
    <button class="btn primary" bindtap="onPay">模拟支付</button>
  </view>
</view>
