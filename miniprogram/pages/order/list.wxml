<!-- 订单列表：状态 tab + 订单卡片 -->
<view class="order-list">
  <image class="app-bg" src="/static/bg/app-bg.jpg" mode="aspectFill" />
  <view class="search-bar">
    <image class="search-icon" src="/static/sousuokuang/search-icon.svg" mode="aspectFit" />
    <input
      class="search-input"
      placeholder="搜索订单号或商品"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearSearch">×</view>
  </view>
  <view class="tabs">
    <view class="tab {{status === 'all' ? 'active' : ''}}" data-key="all" bindtap="onTab">全部</view>
    <view class="tab {{status === '0' ? 'active' : ''}}" data-key="0" bindtap="onTab">待付款</view>
    <view class="tab {{status === '1' ? 'active' : ''}}" data-key="1" bindtap="onTab">待发货</view>
    <view class="tab {{status === '2' ? 'active' : ''}}" data-key="2" bindtap="onTab">待收货</view>
    <view class="tab {{status === '3' ? 'active' : ''}}" data-key="3" bindtap="onTab">待评价</view>
  </view>

  <view class="order-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onDetail">
    <view class="card-head">
      <text class="order-no">{{item.orderNo}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="goods" wx:for="{{item.items}}" wx:for-item="goods" wx:key="goodsId">
      <image class="cover" src="{{goods.goodsImg}}" mode="aspectFill" />
      <view class="g-info">
        <text class="g-title">{{goods.goodsTitle}}</text>
        <text class="g-spec">{{goods.specText}}</text>
      </view>
      <text class="g-price">¥{{goods.price}} x{{goods.quantity}}</text>
    </view>
    <view class="card-foot">
      <text class="amount">共{{item.itemCount}}件 合计：¥{{item.payText}}</text>
      <view class="btns">
        <button wx:if="{{item.status === 0}}" class="btn" data-id="{{item.id}}" catchtap="onCancel">取消</button>
        <button wx:if="{{item.status === 0}}" class="btn primary" data-id="{{item.id}}" catchtap="onPay">付款</button>
      </view>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty-tip">暂无相关订单</view>
</view>
