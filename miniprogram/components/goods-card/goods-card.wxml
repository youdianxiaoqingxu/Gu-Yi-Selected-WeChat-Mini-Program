<!-- 商品卡片：封面 + 标题 + 价格 + 工艺标签 -->
<view class="goods-card" bindtap="onTap">
  <image class="cover" src="{{goods.coverImg}}" mode="aspectFill" />
  <view class="body">
    <text class="title">{{goods.title}}</text>
    <view class="foot">
      <text class="price">¥{{priceText}}</text>
      <text wx:if="{{goods.craft}}" class="craft">{{goods.craft}}</text>
    </view>
  </view>
</view>

