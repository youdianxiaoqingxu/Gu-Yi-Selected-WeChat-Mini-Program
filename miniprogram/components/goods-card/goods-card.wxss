.goods-card {
  overflow: hidden;
  background: #FFFDF7;
  border: 1rpx solid #DDC6A5;
  border-radius: 8px;
}

.cover {
  width: 100%;
  height: 320rpx;
  display: block;
}

.body {
  padding: 20rpx;
}

.title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 76rpx;
  font-size: 28rpx;
  line-height: 38rpx;
  color: #2B211B;
}

.foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  font-size: 30rpx;
  font-weight: 600;
  color: #7D5233;
}

.craft {
  max-width: 160rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 4rpx 12rpx;
  border-radius: 6px;
  background: #EDF1E8;
  color: #6D8065;
  font-size: 22rpx;
}

